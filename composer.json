{
  "name": "d3vnz/issuetracker",
  "type": "library",
  "description": "Filament-based issue reporter with optional centralised TicketMate integration (GitHub issues + branded confirmation emails handled remotely).",
  "keywords": ["laravel", "filament", "github", "issue-tracking", "ticketmate"],
  "homepage": "https://github.com/d3vnz/issuetracker",
  "license": "proprietary",
  "authors": [
    {
      "name": "D3V Services Limited",
      "email": "info@d3v.nz",
      "homepage": "https://d3v.nz",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^11.0 || ^12.0 || ^13.0",
    "filament/filament": "^3.0 || ^4.0 || ^5.0",
    "graham-campbell/github": "^12.0 || ^13.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "D3vnz\\IssueTracker\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "D3vnz\\IssueTracker\\Providers\\IssueTrackerServiceProvider"
      ],
      "migrations": [
        "database/migrations"
      ]
    }
  },
  "suggest": {
    "ext-openai": "Set OPENAI_API_KEY and ISSUETRACKER_AI_ENABLED=true to enable AI-assisted triage of new issues (duplicate detection + automatic request-for-more-info emails)."
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}